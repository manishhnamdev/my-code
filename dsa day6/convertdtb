//decimal to binary using bit manipulation
#include<iostream>
using namespace std;
int main(){
    int n;
    cout<<"enter the digit you wanna convert="<<endl;
    cin>>n;
    int place=1;
    int ans=0;
    while(n!=0){
        int bit=n&1;
        ans=(place*bit)+ans;
        place=place*10;
        n= n>>1;
    }
    cout<<"the binary of number is"<<ans;

}